FROM python:3.14-slim@sha256:a7fb1e634c4a578f9e0bd6327f11a3cde11b7a9395f48e24360c0988bcc5c2bc AS builder

WORKDIR /app

# Install pg_dump/pg_restore matching the server version (PostgreSQL 16).
# Using a mismatched client version (e.g. pg17 on a pg16 server) creates dumps
# that the server's own pg_restore cannot read, breaking manual CLI restores.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] \
       https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

# Installed into an isolated prefix (not the image's own site-packages) so the
# runtime stage can copy exactly the app's dependencies below, without also
# dragging along pip/setuptools/build-essential/curl/gnupg (#20) — none of
# which the app needs after this point.
COPY requirements.txt .
RUN pip install --no-cache-dir --root-user-action=ignore --prefix=/install -r requirements.txt

# Stage pg_dump/pg_restore plus their full transitive shared-library closure
# (via ldd, not a hand-maintained .so list) into a clean tree mirroring their
# real absolute paths, so the runtime stage below can reconstruct them with a
# single COPY --from without needing apt/curl/gnupg/the pgdg repo at all.
RUN mkdir -p /pg-runtime/usr/lib/postgresql/16/bin \
    && cp /usr/lib/postgresql/16/bin/pg_dump /usr/lib/postgresql/16/bin/pg_restore \
       /pg-runtime/usr/lib/postgresql/16/bin/ \
    && for f in /usr/lib/postgresql/16/bin/pg_dump /usr/lib/postgresql/16/bin/pg_restore; do ldd "$f"; done \
       | awk '{print $3 ? $3 : $1}' \
       | grep '^/' \
       | sort -u \
       | xargs -I{} cp --parents {} /pg-runtime/

FROM python:3.14-slim@sha256:a7fb1e634c4a578f9e0bd6327f11a3cde11b7a9395f48e24360c0988bcc5c2bc AS runtime

WORKDIR /app

# Remove the base image's own pre-installed pip/setuptools/wheel. Neither is
# ever used by this app at runtime (verified: no code path calls pip, no
# runtime import of pkg_resources/setuptools), but Trivy flags known HIGH
# CVEs in pip's vendored msgpack and in setuptools regardless of whether
# they're reachable — see #20/#11. Uses pip's own uninstall (backed by its
# RECORD manifest) rather than a hand-rolled `rm -rf` glob, so companion
# files (console scripts, the _distutils_hack .pth shim) are removed
# correctly instead of left dangling.
RUN python -m pip uninstall -y pip setuptools wheel

COPY --from=builder /install /usr/local
COPY --from=builder /pg-runtime/ /
ENV PATH="/usr/lib/postgresql/16/bin:${PATH}"

# Non-root user (#17): uvicorn/celery have no reason to run as root at
# runtime. Celery Beat's schedule file is redirected to /tmp (see
# beat_schedule_filename in app/tasks/celery_app.py) so appuser never needs
# write access to /app itself — this also sidesteps host/container UID
# mismatches on the dev bind-mount (./backend:/app:z), since reading the
# mount only relies on standard "other" read permissions.
RUN useradd --create-home --uid 1000 appuser
COPY --chown=appuser:appuser . .
USER appuser

ENV PYTHONPATH=/app

# Build-time self-test, run as the actual runtime user: fail the build
# itself, immediately, if the pip/setuptools removal above broke a real
# import of this app's own code, or if the pg_dump/pg_restore
# shared-library closure copied above is incomplete or not executable by
# a non-root user — instead of only discovering either at container start.
RUN python -c "from app.main import app; from app.tasks.celery_app import celery_app" \
    && pg_dump --version && pg_restore --version
