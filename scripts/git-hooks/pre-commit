#!/bin/bash
# Blocks a commit that would introduce known real personal/financial data into
# this public repo. See CLAUDE.md's "Security / secrets and personal data"
# section. This is a denylist of already-confirmed-real identifiers plus a
# file-extension check — not a general PII/secret scanner.
#
# The denylisted identifiers are stored as SHA-256 hashes, never as plaintext,
# so this protective script itself can never become another copy of the real
# data it exists to keep out of the repo.
#
# One-time setup to enable: git config core.hooksPath scripts/git-hooks

set -euo pipefail

denylist_hashes=(
    "abd8cfba151826bb7bf3de57387e9653e9d7f54d61e2e107213b3add4383cf91"
    "a09ac81cc0387df9e5ae8a5d84bfa20854063493dc454123cb6baab94e0403d2"
)

added_lines=$(git diff --cached -U0 -- . ':(exclude)scripts/git-hooks/pre-commit' | grep -E '^\+' | grep -v '^+++ ' || true)

hit=0
while read -r -d ' ' word || [ -n "$word" ]; do
    [ -z "$word" ] && continue
    cleaned=$(printf '%s' "$word" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')
    [ -z "$cleaned" ] && continue
    word_hash=$(printf '%s' "$cleaned" | sha256sum | cut -d' ' -f1)
    for h in "${denylist_hashes[@]}"; do
        if [ "$word_hash" = "$h" ]; then
            hit=1
        fi
    done
done <<< "$(printf '%s' "$added_lines" | tr -s '[:space:]' ' ')"

if [ "$hit" = "1" ]; then
    echo "COMMIT BLOCKED: staged changes contain a real portfolio-owner name." >&2
    echo "Use 'Portfolio 1'/'Portfolio 2' instead — see CLAUDE.md's security section." >&2
    exit 1
fi

forbidden_files=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.local)?$|\.(dump|sql|csv)$' || true)

if [ -n "$forbidden_files" ]; then
    echo "COMMIT BLOCKED: a .env/.dump/.sql/.csv file is staged — these must never" >&2
    echo "be committed (see CLAUDE.md). If this was forced past .gitignore, unstage it." >&2
    echo "Staged file(s):" >&2
    echo "$forbidden_files" >&2
    exit 1
fi

exit 0
