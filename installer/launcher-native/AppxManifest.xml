<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 rescap">

  <!--
    Real Microsoft Store identity for "PIE Manager", assigned by Partner Center when the app
    name was reserved during issue #63 (see PR #64, never merged since that approach — Store-
    distributing only launcher.exe with local elevation fallback — was rejected twice by real
    certification under policies 10.2.5/10.1.5/10.1.2, documented in CLAUDE.md). The reservation
    itself is still valid and reused here for issue #82's different, bundle-everything
    architecture — these are not placeholders, do not change them without updating the
    reservation in Partner Center to match. __VERSION__ is substituted with the real release
    version at build time (build-installer.yml).
  -->
  <Identity
      Name="PIEManager.PIEManager"
      Publisher="CN=2654AE3A-D473-41CE-8C17-0C2734C3B4A3"
      Version="__VERSION__.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PIE Manager</DisplayName>
    <PublisherDisplayName>PIE Manager</PublisherDisplayName>
    <Logo>Assets\Square150x150Logo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-fr" />
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!--
      Full-trust (mediumIL) Desktop Bridge app — confirmed live (issue #82's native-launcher-poc)
      that this trust level does not run inside an AppContainer, so launcher-native.exe's
      bundled Postgres/backend/frontend work exactly like they do unpackaged today, and its
      writes under %USERPROFILE%\PieManager (never AppData) are real and survive uninstall.
    -->
    <Application Id="App" Executable="launcher-native.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements
          DisplayName="PIE Manager"
          Description="Suivi de portefeuille d'investissement multi-comptes"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
