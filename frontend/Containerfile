FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS builder
WORKDIR /app
COPY package.json package-lock.json .
RUN npm ci
COPY . .

FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS runtime
WORKDIR /app
# npm's own bundled node_modules (not this app's) periodically carries HIGH/CRITICAL CVEs
# (tar, brace-expansion, ip-address, undici — see #13) — safe to drop since the dev server
# is invoked via its own binary below, never via `npm run`.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=builder /app /app
EXPOSE 5173
CMD ["node_modules/.bin/vite", "--host", "0.0.0.0"]
